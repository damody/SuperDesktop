{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "superdesktop://evidence/record/1.0.0",
  "title": "SuperDesktop append-only evidence record",
  "type": "object",
  "required": ["schema_version", "task_id", "subcheck", "status", "artifact", "artifact_sha256", "capability_id", "requirement_id", "scenario_id", "gates", "reviewer", "recorded_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "task_id": {"pattern": "^[a-z0-9-]+/[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "subcheck": {"pattern": "^[a-z0-9][a-z0-9-]*$"},
    "status": {"enum": ["passed", "failed", "blocked", "not-applicable", "stale"]},
    "artifact": {"pattern": "^evidence/artifacts/[0-9]+\\.[0-9]+/.+"},
    "artifact_sha256": {"pattern": "^[A-F0-9]{64}$"},
    "capability_id": {"pattern": "^[a-z0-9-]+$"},
    "requirement_id": {"pattern": "^[a-z0-9-]+$"},
    "scenario_id": {"pattern": "^[a-z0-9-]+$"},
    "gates": {"type": "array", "minItems": 1, "items": {"pattern": "^G-[A-Z0-9-]+$"}},
    "reviewer": {"type": "string", "minLength": 1},
    "recorded_at": {"format": "date-time"},
    "replaces": {"type": "string"},
    "superseded_by": {"type": "string"}
  },
  "additionalProperties": false
}

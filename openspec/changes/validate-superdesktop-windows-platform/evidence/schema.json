{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "superdesktop://evidence/record/2.0.0",
    "type":  "object",
    "required":  [
                     "schema_version",
                     "task_id",
                     "subcheck",
                     "status",
                     "artifact",
                     "artifact_sha256",
                     "capability_id",
                     "requirement_id",
                     "scenario_id",
                     "gates",
                     "reviewer",
                     "recorded_at",
                     "procedure",
                     "expected",
                     "actual"
                 ],
    "properties":  {
                       "schema_version":  {
                                              "const":  "2.0.0"
                                          },
                       "task_id":  {
                                       "pattern":  "^[a-z0-9-]+/[0-9]+\\.[0-9]+\\.[0-9]+$"
                                   },
                       "subcheck":  {
                                        "pattern":  "^[a-z0-9][a-z0-9-]*$"
                                    },
                       "status":  {
                                      "enum":  [
                                                   "passed",
                                                   "failed",
                                                   "blocked",
                                                   "not-applicable",
                                                   "stale"
                                               ]
                                  },
                       "artifact":  {
                                        "pattern":  "^evidence/artifacts/[0-9]+\\.[0-9]+/.+"
                                    },
                       "artifact_sha256":  {
                                               "pattern":  "^[A-F0-9]{64}$"
                                           },
                       "capability_id":  {
                                             "pattern":  "^[a-z0-9-]+$"
                                         },
                       "requirement_id":  {
                                              "pattern":  "^[a-z0-9-]+$"
                                          },
                       "scenario_id":  {
                                           "pattern":  "^[a-z0-9-]+$"
                                       },
                       "gates":  {
                                     "type":  "array",
                                     "minItems":  1,
                                     "items":  {
                                                   "pattern":  "^G-[A-Z0-9-]+$"
                                               }
                                 },
                       "reviewer":  {
                                        "type":  "string",
                                        "minLength":  1
                                    },
                       "recorded_at":  {
                                           "format":  "date-time"
                                       },
                       "procedure":  {
                                         "type":  "string",
                                         "minLength":  1
                                     },
                       "expected":  {
                                        "type":  "string",
                                        "minLength":  1
                                    },
                       "actual":  {
                                      "type":  "string",
                                      "minLength":  1
                                  },
                       "replaces":  {
                                        "type":  "string"
                                    },
                       "superseded_by":  {
                                             "type":  "string"
                                         }
                   },
    "additionalProperties":  false
}

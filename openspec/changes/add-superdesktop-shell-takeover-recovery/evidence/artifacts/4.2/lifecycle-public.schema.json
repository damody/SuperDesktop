{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "title":  "SuperDesktop lifecycle event",
    "type":  "object",
    "required":  [
                     "kind",
                     "session_id",
                     "nonce"
                 ],
    "properties":  {
                       "nonce":  {
                                     "minLength":  1,
                                     "type":  "string"
                                 },
                       "terminal":  {
                                        "type":  "string"
                                    },
                       "phase":  {
                                     "type":  "string"
                                 },
                       "session_id":  {
                                          "type":  "integer",
                                          "minimum":  1
                                      },
                       "kind":  {
                                    "enum":  [
                                                 "admission",
                                                 "takeover-phase",
                                                 "rollback",
                                                 "shutdown",
                                                 "recovery-terminal",
                                                 "fatal"
                                             ]
                                }
                   },
    "additionalProperties":  false
}

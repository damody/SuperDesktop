{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "title":  "SuperTaskbar effect",
    "type":  "object",
    "required":  [
                     "kind"
                 ],
    "properties":  {
                       "request_id":  {
                                          "type":  "integer",
                                          "minimum":  1
                                      },
                       "identity":  {
                                        "type":  "string"
                                    },
                       "kind":  {
                                    "enum":  [
                                                 "appbar-register",
                                                 "appbar-position",
                                                 "appbar-remove",
                                                 "activate",
                                                 "minimize",
                                                 "restore",
                                                 "bridge",
                                                 "start"
                                             ]
                                }
                   },
    "additionalProperties":  false
}
